// Cloudflare deployment for eyupdevart.com — a static-assets Worker (no server code).
// `npm run deploy` builds, checks, then ships dist/ to the edge.
// Headers (CSP, HSTS, caching) come from dist/_headers, generated by the build.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "eyupdevart",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Served only on the custom domains — no *.workers.dev mirror, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "eyupdevart.com", "custom_domain": true },
    { "pattern": "www.eyupdevart.com", "custom_domain": true }
  ],
  "env": {
    // `npx wrangler deploy --env staging` → https://eyupdevart-staging.<account>.workers.dev
    "staging": {
      "name": "eyupdevart-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": []
    }
  }
}
